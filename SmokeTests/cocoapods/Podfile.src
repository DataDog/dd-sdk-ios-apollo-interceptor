abstract_target 'Common' do
  pod 'Apollo', '~> 1.0'
  pod 'DatadogApollo', :git => 'https://github.com/DataDog/dd-sdk-ios-apollo-interceptor.git', :GIT_REFERENCE

  target 'App Dynamic iOS' do
    platform :ios, '12.0'
    use_frameworks!

    target 'App Dynamic iOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Static iOS' do
    platform :ios, '12.0'

    target 'App Static iOS Tests' do
      inherit! :search_paths
    end
  end

end

